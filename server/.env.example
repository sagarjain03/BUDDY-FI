# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017

# Port the API listens on
PORT=5000

# Secret used to sign JWTs. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Optional: pin this app to its own database when MONGO_URI has no db in its path.
# MONGO_DB_NAME=buddyfi

# Email. Transport is "file" off production (writes to server/.dev-emails and is
# readable at /api/dev/emails). Set to "resend" with a key to send for real.
EMAIL_TRANSPORT=file
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="BUDDYFI <hello@yourdomain.com>"

# Where the front end lives, used to build links in emails.
APP_URL=http://localhost:5173

# Image storage. "local" (default) writes to server/uploads and serves /uploads.
# Set the Cloudinary variables to switch automatically; it also resizes to 512px.
IMAGE_STORE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Number of proxy hops in front of the app (Render, Railway, nginx = 1).
# Unset means no proxy. Getting this wrong makes rate limiting count every
# request against the proxy's IP and lock out all users at once.
TRUST_PROXY=

# Set to "true" only in automated tests.
DISABLE_RATE_LIMITS=
